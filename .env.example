# EventPass - Configuración de Variables de Entorno

# URL base para los webhooks de n8n (ej. https://mi-instancia-n8n.ejemplo.com/webhook)
# Si no se define o está vacía, el frontend opera de forma fluida en Modo Demostración local.
VITE_N8N_BASE_URL=""

# Opcional: Nombre de usuario del bot de Telegram para la vinculación
VITE_TELEGRAM_BOT_USERNAME="EventPassNotificaBot"

